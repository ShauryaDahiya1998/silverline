# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/

# Environment secrets — .env.example files ARE meant to be committed
.env
.env.local
client/.env
server/.env

# Runtime-generated files — server/index.js creates server/exports/ on boot
# if it's missing. Render's disk is ephemeral (wiped on every deploy/restart),
# so nothing written here survives — see Going-Live-Roadmap.md's note on
# moving to object storage (R2/S3) before relying on this long-term.
server/uploads/
server/exports/

# OS / editor cruft
.DS_Store
*.log
