# Copy this file to keystore.properties (same folder) and fill in your real
# values. keystore.properties is gitignored — never commit your real
# passwords or keystore file. Read by app/build.gradle's signingConfigs.
#
# storeFile: absolute path to the .keystore file generated via keytool, e.g.
#   keytool -genkey -v -keystore ~/remar-release.keystore -alias remar \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=/Users/yourname/remar-release.keystore
storePassword=CHANGE_ME
keyAlias=remar
keyPassword=CHANGE_ME
