DATABASE_URL=postgresql://username:password@localhost:5432/remar_db
JWT_SECRET=your_super_secret_key_here
PORT=5000
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_NUMBER=+14155238886
# Android push (Help Universe new-item notifications, Settings > App
# preferences > Device > Notifications) — the full contents of a Firebase
# service account JSON key, as one line. See server/utils/push.js.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# iOS push — an Apple Push Notification service Auth Key (.p8), created in
# your Apple Developer account. APNS_KEY_PATH is a file path on the server
# (not the key contents). Set APNS_PRODUCTION=true only once you're sending
# to App Store builds rather than a development/TestFlight build.
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=ch.remarschweiz.app
APNS_PRODUCTION=false
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Native iOS Google Sign-In (client/ios/App/App/Info.plist's GIDClientID) —
# a Google ID token's "aud" is always the client ID that requested it, and
# the native app's own iOS-type OAuth client is a different client ID than
# the web one above, so it needs to be separately allow-listed here (see
# server/routes/auth.js's /google route). Leave unset if you haven't set up
# native Google Sign-In.
GOOGLE_IOS_CLIENT_ID=your_ios_google_oauth_client_id.apps.googleusercontent.com
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
